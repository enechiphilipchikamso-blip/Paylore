NODE_ENV=development
NEXT_PUBLIC_ERUDA=false
SOLANA_NETWORK=devnet
SOLANA_RPC_PRIMARY=https://api.devnet.solana.com

# External Devnet setup:
# 1. Create a Helius project with Devnet RPC access. Set the issued API key below.
# 2. Create a QuickNode Solana Devnet RPC endpoint and copy its full HTTP URL below.
#    QuickNode is RPC fallback only; Helius is the only webhook provider.
# 3. Configure a local Solana CLI Devnet signer and fund it with Devnet SOL.
# 4. For Netlify, add these variables to the site's environment settings as
#    server-side values for the required deploy contexts, then redeploy.
# 5. Set the approved subscription recipient, USDC mint, wrapped-USDC mint, and
#    deployed payroll program ID when those addresses are available.
# Token Wrap uses the custom Devnet ID from
# apps/web/src/server/solana/token-wrap-program.ts on Devnet and the official
# canonical ID there for Mainnet. Mainnet itself remains disabled in this app.
# 6. Generate a random 32-byte reserve envelope key, base64-encode it, and store
#    it only in the server environment; never commit it or prefix it NEXT_PUBLIC_.
# 7. Generate a different random 32-byte Gas Tank envelope key. Never reuse the
#    reserve key; keep both values in the server environment only.
# For local development, put credentials/secrets in untracked .env.local.
PAYLORE_NETWORK=devnet
PAYLORE_RPC_PRIMARY_PROVIDER=helius
PAYLORE_RPC_PRIMARY_URL=https://devnet.helius-rpc.com/
PAYLORE_RPC_PRIMARY_API_KEY=
PAYLORE_RPC_SECONDARY_PROVIDER=quicknode
# Copy the full HTTP endpoint URL from QuickNode; it contains endpoint credentials.
PAYLORE_RPC_SECONDARY_URL=
# QuickNode auth is in its HTTP URL; leave this blank unless your provider setup
# requires the optional x-api-key header supported by the server adapter.
PAYLORE_RPC_SECONDARY_API_KEY=
PAYLORE_SUBSCRIPTION_RECIPIENT=
PAYLORE_SUBSCRIPTION_USDC_MINT=
PAYLORE_WRAPPED_USDC_MINT=8wZmMHQY3bCJMhWs8j6BLxvgNLUkCXB2F5tEZPFF8A6q
PAYLORE_PAYROLL_PROGRAM_ID=4zYM9ZjwbAz9jxQ2C69Z83n1s4wceCPk7VzDLKoUnT93
# Generate 32 random bytes and encode as 64 hex characters. Server-only; never NEXT_PUBLIC_.
# Used to derive deterministic hiding openings for confidential payroll amount commitments. Keep it stable; changing it invalidates existing allocation commitments.
PAYLORE_PAYROLL_AMOUNT_COMMITMENT_SECRET=
# Unwrap is enabled by default only after the runtime program, mint, escrow,
# destination and SDK simulation checks succeed. Set false to disable the path.
PAYLORE_TOKEN_WRAP_UNWRAP_ENABLED=true
PAYLORE_RESERVE_ENVELOPE_KEY=
# Optional user-run acceptance harness for a real initialized/funded workspace reserve.
# Supply the existing hosted base URL, workspace ID, and an authenticated session cookie locally only.
# Never commit cookie values or place them in browser-visible variables.
PAYLORE_RESERVE_ACCEPTANCE_BASE_URL=
PAYLORE_RESERVE_ACCEPTANCE_WORKSPACE_ID=
PAYLORE_RESERVE_ACCEPTANCE_COOKIE=
PAYLORE_GAS_TANK_ENVELOPE_KEY=
PAYLORE_HELIUS_WEBHOOK_SECRET=
# Public deployment address whose account activity the webhook monitors.
PAYLORE_HELIUS_DEPLOYMENT_ADDRESS=7dmrSuBZtHzvkuiYgUW386gKYaeeE3jQs4sQsWkQQiUe
# Management settings for the existing Devnet Helius webhook. These are
# server-only. Use the same shared secret in Helius' Authentication Header
# and this app's PAYLORE_HELIUS_WEBHOOK_SECRET.
PAYLORE_HELIUS_MANAGEMENT_API_KEY=
PAYLORE_HELIUS_WEBHOOK_ID=

# Optional for a configured Helius webhook endpoint.
# Use a funded Solana CLI Devnet keypair for local Anchor builds/deploys; that
# signer is not an application environment variable and must never be checked in.
DATABASE_URL=postgresql://example.invalid:5432/paylore?sslmode=require
# QA-only regression backup target. Keep this in untracked .env.local, never use a production URL.
PAYLORE_QA_DATABASE_URL=postgresql://example.invalid:5432/paylore_qa?sslmode=require

# Optional: require the currently deployed Paylore Payroll Program upgrade authority to match this public address during the Devnet bytecode audit.
PAYLORE_EXPECTED_PROGRAM_UPGRADE_AUTHORITY=

# Optional hosted acceptance check after the scheduled subscription-reminder worker runs.
# Use a workspace admin's authenticated session cookie locally only; never commit its value.
PAYLORE_SUBSCRIPTION_REMINDER_ACCEPTANCE_BASE_URL=
PAYLORE_SUBSCRIPTION_REMINDER_ACCEPTANCE_WORKSPACE_ID=
PAYLORE_SUBSCRIPTION_REMINDER_ACCEPTANCE_COOKIE=
# Exact paid-period-end timestamp (ISO 8601); DAYS must be 7 or 1 for the reminder key to verify.
PAYLORE_SUBSCRIPTION_REMINDER_ACCEPTANCE_PERIOD_END=
PAYLORE_SUBSCRIPTION_REMINDER_ACCEPTANCE_DAYS=

# Optional rendered claim-outcome and cross-wallet browser regression.
# Use a dedicated workspace with one unclaimed allocation for each contributor and
# verified confidential accounts. Storage-state files contain session credentials:
# keep them local and untracked. The spec intercepts claim POST requests; it submits no
# payroll or account transaction.
PAYLORE_E2E_CLAIM_OUTCOME_URL=
PAYLORE_E2E_CLAIM_STORAGE_STATE=
PAYLORE_E2E_CLAIM_ALLOCATION_ID=
PAYLORE_E2E_CLAIM_OTHER_WALLET_STORAGE_STATE=
PAYLORE_E2E_CLAIM_OTHER_ALLOCATION_ID=
